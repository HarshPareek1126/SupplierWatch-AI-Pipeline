      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  return {\n    json: {\n      supplier: item.json.supplier || $('Loop Over Items').first().json.name || '',\n      query: item.json.query || '',\n      processed_at: new Date().toISOString()\n    }\n  };\n});"
