    {
      "parameters": {
        "jsCode": "const metaByUrl = new Map(\n  $('Add hash').all().map(i => [i.json.url, i.json])\n);\n\nconst toISO = (d) => {\n  const t = new Date(d);\n  return isNaN(t.getTime()) ? null : t.toISOString();\n};\n\nreturn $input.all().map((item, i) => {\n  const src = $('Filter Irrelevant News').itemMatching(i).json;\n  const meta = metaByUrl.get(src.url) || {};\n\n  let aiData = {};\n  try {\n    const raw = String(item.json.output || '');\n    aiData = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n  } catch (e) {\n    aiData = { severity: 1, confidence: 0, event_type: 'error', reason: 'Failed to parse LLM' };\n  }\n\n  const severity = Math.min(5, Math.max(1, Number(aiData.severity) || 1));\n  const rawConf = Number(aiData.confidence);\n  const confidence = Number.isFinite(rawConf) ? Math.min(1, Math.max(0, rawConf)) : 0.5;\n  const criticality = 4;\n\n  const riskScore = Math.round(100 * ((severity - 1) / 4) * (criticality / 5) * confidence);\n\n  return {\n    json: {\n      source_hash: src.source_hash || meta.source_hash,\n      supplier: src.supplier,\n      title: src.title,\n      url: src.url,\n      published_at: toISO(src.published_at || meta.published_at),\n      event_type: aiData.event_type || 'other',\n      severity,\n      risk_score: riskScore,\n      reason: aiData.reason || 'No reason provided'\n    }\n  };\n});"
      },
