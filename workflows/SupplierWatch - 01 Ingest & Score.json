    {
      "parameters": {
        "jsCode": "const seen = new Set($('Get many rows').all().map(i => i.json.source_hash).filter(Boolean));\nconst cutoff = Date.now() - 48 * 60 * 60 * 1000;\nconst out = [];\n\nfor (const item of $('Add hash').all()) {\n  const h = item.json.source_hash;\n  if (seen.has(h)) continue;\n  const t = new Date(item.json.published_at).getTime();\n  if (!isNaN(t) && t < cutoff) continue;\n  seen.add(h);\n  out.push(item);\n}\nreturn out;"
      },
