    {
      "parameters": {
        "jsCode": "const rows = $('Get many rows').all().map(i => i.json).filter(r => r && r.id);\n\nif (!rows.length) {\n  return [{ json: { empty: true, count: 0, text: '📋 SupplierWatch Daily Digest: no medium-risk events in the last 24 hours.' } }];\n}\n\nrows.sort((a, b) => b.risk_score - a.risk_score);\nconst top = rows.slice(0, 15);\n\nconst lines = top.map((r, i) =>\n  `${i + 1}. [${r.supplier}] ${r.title} | type: ${r.event_type} | risk: ${r.risk_score} | ${r.reason}`);\nconst plain = top.map((r, i) =>\n  `${i + 1}. ${r.supplier}: ${r.title} (risk ${r.risk_score})`).join('\\n');\n\nconst prompt = 'You are a procurement risk analyst. Write a short executive summary (max 120 words) of these supplier events from the last 24 hours. Put the most important first and say what to watch. Plain text only.\\n\\n' + lines.join('\\n');\n\nreturn [{ json: { empty: false, count: rows.length, prompt, plain } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
