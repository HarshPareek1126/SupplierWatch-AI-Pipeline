    {
      "parameters": {
        "jsCode": "const ai = String($json.output || $json.text || '').trim();\nconst base = $('Build Prompt').first().json;\nconst body = ai.length > 20 ? ai : base.plain;\n\n// Telegram reads * _ ` [ ] as formatting. Remove them so the send can't fail.\nconst clean = String(body)\n  .replace(/^#+[ \\t]*/gm, '')\n  .replace(/^[ \\t]*[*•][ \\t]+/gm, '- ')\n  .replace(/[*`\\[\\]]/g, '')\n  .replace(/_/g, ' ');\n\nreturn [{ json: { text: ('📋 SupplierWatch Daily Digest (' + base.count + ' events)\\n\\n' + clean).slice(0, 3900) } }];"
      },
      "type": "n8n-nodes-base.code",
